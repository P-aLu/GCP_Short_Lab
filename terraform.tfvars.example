# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored — never commit it.

# ── GCP projects ──────────────────────────────────────────────────────────────
# Two separate GCP projects are required. Create them in the GCP console before
# running any terraform apply or deploy-chain.sh.
#
# Naming convention: [uid]-<name>-palu  (uid is generated by lab-01 on first apply)
# Example:           a1b2c3d4-deployments-palu  /  a1b2c3d4-webapp-palu

# Project A — deployments project (lab-01-gsc-privesc)
project_id = "<DEPLOYMENTS_PROJECT_ID>"

# Project B — webapp project (lab-01-gsc-privesc-b + lab-02-kms-privesc)
webapp_project_id = "<WEBAPP_PROJECT_ID>"

# ── Shared settings ───────────────────────────────────────────────────────────
# GCP region for all resources.
region = "europe-west1"

# GCP zone for compute resources.
zone = "europe-west1-b"

# GCS bucket used ONLY for Terraform remote state — separate from the lab scenario bucket.
# Create once: gcloud storage buckets create gs://<NAME> --uniform-bucket-level-access
state_bucket = "<YOUR_STATE_BUCKET>"

# Your name or LDAP — applied as the `owner` label to every resource.
owner = "<your-name>"

# ── Optional overrides ────────────────────────────────────────────────────────
# Cloud Function URL — leave commented out on first apply. deploy-chain.sh sets
# this automatically. If running lab-01 manually, fill in after deploying lab-01-b.
# cf_function_url = "https://<REGION>-<WEBAPP_PROJECT_ID>.cloudfunctions.net/<uid>-flag-api"
