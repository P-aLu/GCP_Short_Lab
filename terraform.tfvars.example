# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored — never commit it.
#
# Recommended: run scripts/setup.sh to generate this file automatically.
#   ./scripts/setup.sh --billing-account=XXXXXX-XXXXXX-XXXXXX

# ── GCP projects ──────────────────────────────────────────────────────────────
# Three separate GCP projects are required.
# Run scripts/setup.sh to create them automatically, or create them manually
# in the GCP console before running deploy-chain.sh.
#
# Naming convention: [uid]-<name>-palu  (uid generated by lab-01 or setup.sh)
# Example:           a1b2c3d4-deployments-palu

# Project A — deployments project (lab-01-gsc-privesc)
project_id = "<DEPLOYMENTS_PROJECT_ID>"

# Project B — webapp project (lab-01-gsc-privesc-b + lab-02-kms-privesc)
webapp_project_id = "<WEBAPP_PROJECT_ID>"

# Project C — admin project (lab-03-admin-takeover)
admin_project_id = "<ADMIN_PROJECT_ID>"

# ── Shared settings ───────────────────────────────────────────────────────────
# GCP region for all resources.
region = "europe-west1"

# GCP zone for compute resources.
zone = "europe-west1-b"

# Single GCS bucket for both Terraform remote state and lab scenario files.
# Named [uid]-deployments-palu — created automatically by setup.sh/setup.ps1.
state_bucket = "<YOUR_STATE_BUCKET>"

# Your name or LDAP — applied as the `owner` label to every resource.
owner = "<your-name>"

# ── Optional overrides ────────────────────────────────────────────────────────
# Pre-set deployment UID — written by setup.sh so project names are fixed before
# Terraform runs. When present, lab-01 uses this instead of generating random_id.
# Leave commented out if you are managing projects manually.
# deployment_uid = "<8-char-hex>"

# Cloud Function URL — leave commented out on first apply. deploy-chain.sh sets
# this automatically. If running lab-01 manually, fill in after deploying lab-01-b.
# cf_function_url = "https://<REGION>-<WEBAPP_PROJECT_ID>.cloudfunctions.net/<uid>-flag-api"
